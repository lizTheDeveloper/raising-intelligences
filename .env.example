# Required
OPENROUTER_API_KEY=sk-or-...

# Optional — restrict CORS to your deployment domain (defaults to http://localhost:5173)
ALLOWED_ORIGIN=https://yourdomain.com

# Optional — "standard" | "premium" (defaults to "standard"). OpenRouter serves both.
MODEL_TIER=standard

# Optional — omit to run with in-memory storage
DATABASE_URL=postgres://postgres:postgres@localhost:5432/raising_intelligences

# Recommended — enables the primary content-safety layer: OpenAI's free
# Moderation API (has a purpose-trained "sexual/minors" category) checks every
# parent message before it reaches the kid-LLM. Without this key, moderation
# falls back to the contextual LLM classifier alone (safety/moderation.ts).
OPENAI_API_KEY=sk-...

# Optional — omit to disable Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# Optional — error reporting to self-hosted GlitchTip (Sentry-compatible).
# When unset, error reporting is a complete no-op (dev/tests/CI unaffected).
# Get the real DSN from the GlitchTip "raising-intelligences" project settings.
SENTRY_DSN=https://<publicKey>@errors.multiversegames.ai/<projectId>
# Optional — labels events by environment (defaults to NODE_ENV, else "development")
SENTRY_ENVIRONMENT=production
# Optional — release/version tag for events (e.g. a git SHA)
SENTRY_RELEASE=

# Intro image generation uses OPENROUTER_API_KEY (already required above)
# Run: OPENROUTER_API_KEY=... node scripts/generate-intro-images.mjs

# Optional — enables the admin dashboard at /raising-intelligences/admin
# Requires DATABASE_URL to be set (admin only works with Postgres)
ADMIN_TOKEN=your-secret-admin-token

# Optional — research features (wait-time questions, repair labels, follow-up
# offer). Leave false until the copy and the consent and age handling have been
# reviewed. Only the exact value "true" enables them.
RI_RESEARCH_ENABLED=false

# Optional — the shared Multiverse Games Stripe checkout service (ceo/stripe-webhook).
# Defaults to the production endpoint; only override for local testing against a
# different stripe-webhook instance.
STRIPE_WEBHOOK_CHECKOUT_URL=https://pay.multiversegames.ai/create-checkout-session

# Optional — the $20 per-child partner payment (host pays once, when the
# partner has joined). Off unless exactly "on". With it on, a Stripe key is also
# needed, or partner play simply stays free (logged as partner_paywall_unconfigured).
RI_PARTNER_PAYWALL=off
# A TEST-mode key (sk_test_… or a restricted rk_test_… with Checkout Sessions
# write + Refunds write). A live key is refused unless RI_STRIPE_LIVE_PAYMENTS=true.
RI_STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint
# https://multiversegames.ai/raising-intelligences/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
RI_STRIPE_WEBHOOK_SECRET=
# The only switch that lets a live payment key be used. Leave unset until going live.
RI_STRIPE_LIVE_PAYMENTS=
# Where Stripe sends the player back. Defaults to ALLOWED_ORIGIN + /raising-intelligences in production.
RI_PUBLIC_BASE_URL=

# Optional — stranger mode (raise a child with an adult you haven't met).
# OFF unless exactly "meetup" or "public". "meetup" shows it only on links
# carrying ?meetup=<code> for a code listed in RI_MEETUP_CODES.
RI_STRANGER_MODE=off
# Comma-separated, lower-case letters/digits/hyphens, 2-40 chars, e.g. tea-party-dec
RI_MEETUP_CODES=
# Stripe Identity: a RESTRICTED key (rk_live_…; plain sk_ keys are refused)
# with Identity "Verification Sessions and Reports" Write, "Verification
# Results" Read and "Recent Detailed Verification Results" Read. Without an
# IP allowlist on the key, detailed results are readable for 48 hours only,
# so keep the identity webhook configured. A test-mode check never admits
# anyone in production.
RI_STRIPE_IDENTITY_KEY=
# Signing secret of the webhook endpoint
# https://multiversegames.ai/raising-intelligences/api/stripe/identity-webhook
# (events: identity.verification_session.verified, .requires_input, .canceled)
RI_STRIPE_IDENTITY_WEBHOOK_SECRET=
# REQUIRED for stranger mode: the secret HMAC key for the opaque account and
# document ids in stranger-mode records. At least 32 bytes; generate with
#   openssl rand -hex 32
# Without it (or if it is shorter) stranger mode refuses to start and stays
# off. Set it once and never change it: changing it orphans every stored
# result, including "minor" results that must stay final.
RI_STRANGER_PEPPER=
# Matching: how long a matched pair has to arrive, and how long a queued
# player may go without polling before they drop out of the queue.
# RI_STRANGER_JOIN_WINDOW_MS=180000
# RI_STRANGER_QUEUE_IDLE_MS=90000
# Delete each Identity check at Stripe once its outcome is stored (default true).
RI_IDENTITY_REDACT=true

# Optional
PORT=3000
NODE_ENV=development
